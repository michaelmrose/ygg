#!/usr/bin/env bb
;; Ygg: conservative ZFS workspace clones for a repository at a dataset root.
;; Usage: ygg [-n N] create | status [--edn] | clean
;;        ygg tail [--workers|--stderr|--all] [--run PATH] [--once]
;;        ygg report [--edn] [--run PATH]
;;        ygg explain [--run PATH]
;;        ygg jobs [--all] [--sort duration|error] [--run PATH]
;;        ygg report --timeline [--run PATH] | ygg timeline [--run PATH]
;; Clone mountpoints: REPO/.ygg/workers/1 ... N; run results: REPO/.ygg/runs/.
;; Shard holds an exclusive FileChannel lock on .ygg/.workers.lock while using
;; the clones. Ygg clean refuses to proceed while that lock is held.
;; Ygg command serialization uses .ygg/.command.lock, never a root-level
;; .ygg.lock. An existing legacy root lock requires explicit safe migration.
;; Privileged ZFS operations always use sudo -n -- zfs (run sudo -v first).
(require '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.java.shell :as shell]
         '[clojure.string :as str])
(import '[java.nio.channels FileChannel]
        '[java.nio.file Files LinkOption OpenOption StandardOpenOption]
        '[java.io ByteArrayOutputStream RandomAccessFile]
        '[java.nio.charset StandardCharsets]
        '[java.nio.file.attribute BasicFileAttributes]
        '[java.time Instant ZoneId]
        '[java.time.format DateTimeFormatter]
        '[java.util UUID])

(def ^:private state-file ".ygg-state.edn")
(def ^:private no-follow (into-array LinkOption [LinkOption/NOFOLLOW_LINKS]))
(def ^:private safe-dataset #"[A-Za-z0-9][A-Za-z0-9_.:-]*(/[A-Za-z0-9][A-Za-z0-9_.:-]*)*")

(defn- fail! [message & [data]] (throw (ex-info message (or data {}))))
(defn- f [& xs] (apply io/file xs))
(defn- canonical [value] (.getCanonicalPath (io/file value)))
(defn- exists? [p] (Files/exists (.toPath (io/file p)) no-follow))
(defn- symlink? [p] (Files/isSymbolicLink (.toPath (io/file p))))
(defn- children [p]
  (when (.isDirectory (io/file p))
    (with-open [s (Files/list (.toPath (io/file p)))]
      (vec (iterator-seq (.iterator s))))))
(defn- read-edn [p]
  (try (edn/read-string (slurp p))
       (catch Exception e (fail! (str "Cannot read EDN: " p)
                                 {:cause (.getMessage e)}))))

;; The caller cannot select a privileged command or executable through EDN.
(defn- execute! [privileged? args]
  (let [command (concat (if privileged? ["sudo" "-n" "--" "zfs"] ["zfs"]) args)
        result (apply shell/sh command)]
    (when-not (zero? (:exit result))
      (fail! (str "ZFS command failed: " (str/join " " command)
                  "\n" (str/trim (or (:err result) "")))
             {:exit (:exit result)}))
    (str/trim (:out result))))
(defn- zfs [& args] (execute! false args))
(defn- sudo-zfs [& args] (execute! true args))
(defn- probe-zfs [& args] (apply shell/sh (concat ["zfs"] args)))

(defn- valid-dataset! [name]
  (when-not (and (string? name) (re-matches safe-dataset name))
    (fail! (str "Unsafe ZFS dataset name: " (pr-str name))))
  name)
(defn- source-dataset [root]
  (let [rows (str/split-lines (zfs "list" "-H" "-t" "filesystem" "-o" "name,mountpoint"))
        matching (for [row rows
                       :let [[dataset point] (str/split row #"\t" 2)]
                       :when (and point (str/starts-with? point "/")
                                  (= root (canonical point)))]
                   (valid-dataset! dataset))]
    (when-not (= 1 (count matching))
      (fail! (str "Repository root is not exactly one ZFS filesystem mountpoint: " root)))
    (first matching)))
(defn- property-value [dataset property]
  (zfs "get" "-H" "-o" "value" property dataset))
(defn- zfs-exists? [type name]
  (let [r (probe-zfs "list" "-H" "-t" type "-o" "name" name)]
    (cond
      (zero? (:exit r)) (= name (str/trim (:out r)))
      (re-find #"(?i)(does not exist|not found)" (or (:err r) "")) false
      :else (fail! (str "Unable to determine ZFS existence: " name "\n" (:err r))))))

(defn- workspace [root] (f root ".ygg"))
(defn- worker-dir [root] (f (workspace root) "workers"))
(defn- state-path [root] (f (workspace root) state-file))
(defn- worker-lock-path [root] (f (workspace root) ".workers.lock"))
(defn- command-lock-path [root] (f (workspace root) ".command.lock"))
(defn- legacy-lock-path [root] (f root ".ygg.lock"))
(defn- git-root! [root]
  (when-not (exists? (f root ".git"))
    (fail! (str "Missing Git repository at dataset root: " root))))
(defn- ordinary-directory! [p]
  (when (symlink? p) (fail! (str "Refusing symlink directory: " p)))
  (when (and (exists? p) (not (.isDirectory (io/file p))))
    (fail! (str "Not a directory: " p))))
(defn- workspace-shape! [root]
  (let [w (workspace root) workers (worker-dir root)]
    (ordinary-directory! w)
    (ordinary-directory! workers)
    (ordinary-directory! (f w "runs"))
    (when (symlink? (state-path root)) (fail! "Manifest may not be a symlink"))
    (doseq [[label lock-path] [["Worker" (worker-lock-path root)]
                               ["Command" (command-lock-path root)]]]
      (when (symlink? lock-path)
        (fail! (str label " lock may not be a symlink")))
      (when (and (exists? lock-path) (not (.isFile lock-path)))
        (fail! (str label " lock is not a regular file"))))))
(defn- check-workspace! [root]
  (workspace-shape! root)
  (let [w (workspace root) workers (worker-dir root)]
    (when (exists? (state-path root))
      (fail! "Existing Ygg manifest; clean or recover first"))
    (when (seq (children workers))
      (fail! "Worker mountpoints are not empty; refusing create"))
    (when-not (exists? w)
      (when-not (.mkdir w) (fail! "Unable to create .ygg/")))
    (when-not (exists? workers)
      (when-not (.mkdir workers) (fail! "Unable to create .ygg/workers/")))))
(defn- nested-zfs! [root source]
  (doseq [row (str/split-lines (zfs "list" "-H" "-t" "filesystem" "-o" "name,mountpoint"))
          :let [[name mp] (str/split row #"\t" 2)]
          :when (and (not= name source) mp
                     (str/starts-with? mp (str root "/")))]
    (fail! (str "Nested ZFS filesystem must not be omitted from clone: " name " at " mp))))
(defn- run-id []
  (str (.format (DateTimeFormatter/ofPattern "yyyyMMdd-HHmmss")
                (.atZone (Instant/now) (ZoneId/of "UTC")))
       "-" (subs (str (UUID/randomUUID)) 0 8)))
(defn- new-state [root source n]
  (let [id (run-id)]
    {:version 3 :source-dataset source :source-path root
     :source-guid (property-value source "guid") :run-id id
     :snapshot (str source "@ygg-" id) :snapshot-guid nil
     :clones (mapv (fn [i] {:dataset (str source "/ygg-" id "-" i)
                              :mountpoint (str (f (worker-dir root) (str i)))
                              :guid nil})
                   (range 1 (inc n)))}))
(defn- write-state! [root state]
  (let [dst (state-path root) temp (f (workspace root) ".ygg-state-writing")]
    (when (or (symlink? dst) (exists? temp))
      (fail! "Unsafe manifest target or abandoned manifest temporary file"))
    (spit temp (str (pr-str state) "\n"))
    (try
      (Files/move (.toPath temp) (.toPath dst)
                  (into-array java.nio.file.CopyOption
                              [java.nio.file.StandardCopyOption/ATOMIC_MOVE
                               java.nio.file.StandardCopyOption/REPLACE_EXISTING]))
      (catch Exception e
        (fail! (str "Cannot atomically write manifest: " (.getMessage e)))))))
(defn- valid-manifest! [state root source]
  (when-not (and (map? state) (= 3 (:version state))
                 (= root (:source-path state))
                 (= source (:source-dataset state))
                 (re-matches safe-dataset source)
                 (string? (:source-guid state))
                 (re-matches #"[0-9]{8}-[0-9]{6}-[a-f0-9]{8}" (or (:run-id state) ""))
                 (= (:snapshot state) (str source "@ygg-" (:run-id state)))
                 (or (nil? (:snapshot-guid state)) (string? (:snapshot-guid state)))
                 (vector? (:clones state)) (<= 1 (count (:clones state)) 256))
    (fail! "Manifest does not describe this Ygg run and source dataset"))
  (doseq [[idx clone] (map-indexed vector (:clones state))]
    (when-not (and (map? clone)
                   (= (:dataset clone) (str source "/ygg-" (:run-id state) "-" (inc idx)))
                   (= (:mountpoint clone) (str (f (worker-dir root) (str (inc idx)))))
                   (or (nil? (:guid clone)) (string? (:guid clone))))
      (fail! "Manifest includes an unexpected clone target"))))
(defn- source-unchanged! [state]
  (when-not (= (:source-guid state) (property-value (:source-dataset state) "guid"))
    (fail! "Source filesystem identity changed; refusing operation"))
  (when-let [g (:snapshot-guid state)]
    (when-not (and (zfs-exists? "snapshot" (:snapshot state))
                   (= g (property-value (:snapshot state) "guid")))
      (fail! "Origin snapshot identity changed; refusing operation"))))
(defn- exact-clone! [state {:keys [dataset mountpoint guid]}]
  (when-not (and (string? guid) (not (str/blank? guid))
                 (zfs-exists? "filesystem" dataset)
                 (= guid (property-value dataset "guid"))
                 (= (:snapshot state) (property-value dataset "origin"))
                 (= mountpoint (property-value dataset "mountpoint")))
    (fail! (str "Refusing unverified clone: " dataset))))
(defn- mounted-clone! [state clone]
  (exact-clone! state clone)
  (when-not (and (= "yes" (property-value (:dataset clone) "mounted"))
                 (.isDirectory (io/file (:mountpoint clone)))
                 (not (symlink? (:mountpoint clone))))
    (fail! (str "Verified clone is not safely mounted: " (:dataset clone)))))
(defn- no-dependents! [dataset]
  ;; Deliberately never destroy recursively or force an unmount.
  (let [desc (str/split-lines
              (zfs "list" "-H" "-r" "-t" "filesystem,volume" "-o" "name" dataset))
        snaps (remove str/blank? (str/split-lines
               (zfs "list" "-H" "-r" "-t" "snapshot" "-o" "name" dataset)))]
    (when-not (= [dataset] desc)
      (fail! (str "Clone has child datasets; refusing destruction: " dataset)))
    (when (seq snaps)
      (fail! (str "Clone has snapshots; refusing destruction: " dataset)))))

;; Every Shard run holds this same lock on the repository host while workers
;; use their clones. Filesystem claims are NOT a substitute for this lease.
;; A nonblocking FileChannel lock also makes ygg clean fail rather than wait.
(defn- with-file-lock [p message work]
  (when (symlink? p) (fail! (str "Refusing symlink lock: " p)))
  (with-open [channel (FileChannel/open (.toPath (io/file p))
                                        (into-array OpenOption
                                                    [StandardOpenOption/CREATE
                                                     StandardOpenOption/WRITE]))]
    (let [lock (try (.tryLock channel)
                    (catch Exception _ nil))]
      (when-not lock (fail! message))
      (work))))
(defn- with-worker-idle [root work]
  (workspace-shape! root)
  (let [p (workspace root)]
    (do (when-not (exists? p)
          (when-not (.mkdir p) (fail! "Unable to create .ygg/")))
        (with-file-lock (worker-lock-path root)
          "Shard or another worker holds .ygg/.workers.lock; refusing ZFS mutation"
          work))))
(defn- create! [root source n]
  (git-root! root)
  (nested-zfs! root source)
  (check-workspace! root)
  ;; `.ygg/runs/` may hold previous results. It is ordinary data and is
  ;; consequently included in a snapshot of the parent dataset. Workers are
  ;; distinct mounted filesystems; ZFS does not recursively snapshot them.
  (let [initial (new-state root source n)
        snapshot (:snapshot initial)]
    ;; The source snapshot is intentionally retained after clean.
    (println "Create source snapshot:" snapshot)
    (sudo-zfs "snapshot" snapshot)
    (let [state (atom (assoc initial :snapshot-guid (property-value snapshot "guid")))]
      (write-state! root @state)
      (doseq [[idx {:keys [dataset mountpoint]}] (map-indexed vector (:clones @state))]
        (println "Create clone:" dataset "->" mountpoint)
        ;; -u prevents implicit mounts before identity is recorded and checked.
        (sudo-zfs "clone" "-u" "-o" (str "mountpoint=" mountpoint) snapshot dataset)
        (let [guid (property-value dataset "guid")]
          (swap! state assoc-in [:clones idx :guid] guid)
          (write-state! root @state))
        (exact-clone! @state (get-in @state [:clones idx]))
        (sudo-zfs "mount" dataset)
        (mounted-clone! @state (get-in @state [:clones idx])))
      (println "Created" n "clones under" (str (worker-dir root)))
      (println "Original snapshot retained:" snapshot))))
(defn- clean! [root source]
  (let [p (workspace root) sf (state-path root)]
    (workspace-shape! root)
    (if-not (exists? sf)
      (if (seq (children (worker-dir root)))
        (fail! "Worker mountpoints without manifest; refusing cleanup")
        (println "No recorded Ygg run"))
      (let [state (read-edn sf)]
        (valid-manifest! state root source)
        (source-unchanged! state)
        ;; Verify all existing clones before any destructive operation.
        (doseq [clone (:clones state)
                :when (zfs-exists? "filesystem" (:dataset clone))]
          (exact-clone! state clone)
          (no-dependents! (:dataset clone)))
        (doseq [{:keys [dataset mountpoint] :as clone} (reverse (:clones state))
                :when (zfs-exists? "filesystem" dataset)]
          (exact-clone! state clone)
          (when (= "yes" (property-value dataset "mounted"))
            (println "Unmount verified clone:" dataset)
            (sudo-zfs "unmount" dataset))
          (exact-clone! state clone)
          (no-dependents! dataset)
          (when (= "yes" (property-value dataset "mounted"))
            (fail! (str "Clone is still mounted: " dataset)))
          (println "Destroy verified clone:" dataset)
          (sudo-zfs "destroy" dataset)
          (when (and (not (symlink? mountpoint))
                     (.isDirectory (io/file mountpoint))
                     (empty? (children mountpoint)))
            (.delete (io/file mountpoint))))
        (when-not (.delete sf) (fail! "Could not remove Ygg manifest"))
        (println "Cleaned clones; original snapshot retained:" (:snapshot state))))))
(defn- verified-state! [root source]
  (workspace-shape! root)
  (let [sf (state-path root)]
    (if-not (exists? sf)
      (do (when (seq (children (worker-dir root)))
            (fail! "Orphan worker mountpoints without a manifest"))
          {:version 1 :status :idle :source-path root
           :source-dataset source :clones []})
      (let [state (read-edn sf)]
        (valid-manifest! state root source)
        (source-unchanged! state)
        (when-not (and (string? (:snapshot-guid state))
                       (not (str/blank? (:snapshot-guid state))))
          (fail! "Snapshot creation incomplete; refusing verified status"))
        (doseq [clone (:clones state)] (mounted-clone! state clone))
        {:version 1 :status :ready :source-path root
         :source-dataset source :source-guid (:source-guid state)
         :run-id (:run-id state) :snapshot (:snapshot state)
         :snapshot-guid (:snapshot-guid state)
         :clones (mapv (fn [{:keys [dataset mountpoint guid]}]
                         {:dataset dataset :mountpoint mountpoint :guid guid
                          :mounted? true})
                       (:clones state))}))))
(defn- status! [root source as-edn?]
  (let [status (verified-state! root source)]
    (if as-edn?
      (println (pr-str status))
      (if (= :idle (:status status))
        (println "No recorded Ygg run")
        (do (println "Origin snapshot:" (:snapshot status) "(retained on clean)")
            (doseq [clone (:clones status)]
              (println (:dataset clone) "->" (:mountpoint clone) "[verified mounted]")))))))

;; Live run output is a read-only operation: no ZFS command, sudo, FileChannel
;; lock, or mutable job receipt is involved. The authoritative logs and manifest
;; remain under the project-owned .ygg/runs/<run-id> directory.
(def ^:private tail-run-name #"run-[A-Za-z0-9][A-Za-z0-9_-]*")
(def ^:private tail-jvm-name
  #"jvm-([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.(stdout|stderr)\.log")
(def ^:private tail-worker-name #"worker-([1-9][0-9]*)(?:-phase-([1-9][0-9]*))?\.log")

(defn- tail-ordinary-dir! [path]
  (when-not (Files/isDirectory (if (instance? java.nio.file.Path path)
                                 path (.toPath (io/file path))) no-follow)
    (fail! (str "Missing or unsafe run directory: " path))))

(defn- tail-run! [root specified]
  (let [w (workspace root)
        runs (f w "runs")
        _ (tail-ordinary-dir! w)
        _ (tail-ordinary-dir! runs)
        runs-path (.toAbsolutePath (.normalize (.toPath runs)))
        requested (if specified
                    (let [p (.toPath (io/file specified))]
                      (if (and (= 1 (.getNameCount p))
                               (re-matches tail-run-name (str p)))
                        (.resolve runs-path p)
                        (.toAbsolutePath p)))
                    (let [latest (.resolve runs-path "latest")]
                      (when-not (Files/isSymbolicLink latest)
                        (fail! (str "No published latest Ygg run in " runs)))
                      (let [target (Files/readSymbolicLink latest)]
                        (when-not (and (not (.isAbsolute target))
                                       (= 1 (.getNameCount target))
                                       (re-matches tail-run-name (str target)))
                          (fail! "Unsafe .ygg/runs/latest target"))
                        (.resolve runs-path target))))
        run (.normalize requested)]
    (when-not (and (= runs-path (.getParent run))
                   (re-matches tail-run-name (str (.getFileName run))))
      (fail! "Selected run must be a direct child of .ygg/runs"
             {:run (str run)}))
    (tail-ordinary-dir! run)
    (let [manifest (.resolve run "jobs.edn")
          logs (.resolve run "logs")]
      (when-not (Files/isRegularFile manifest no-follow)
        (fail! "Run has no published, regular jobs.edn"))
      (tail-ordinary-dir! logs))
    run))

(defn- tail-regular-files [directory filename-pattern]
  (with-open [files (Files/list (if (instance? java.nio.file.Path directory)
                                  directory (.toPath (io/file directory))))]
    (->> (iterator-seq (.iterator files))
         (filter #(re-matches filename-pattern (str (.getFileName %))))
         (map (fn [path]
                (when-not (Files/isRegularFile path no-follow)
                  (fail! "Refusing non-regular or symlinked tail log"
                         {:path (str path)}))
                path))
         (sort-by str)
         vec)))

(defn- tail-worker-ids [run]
  (into {}
        (keep (fn [p]
                (let [[_ index phase] (re-matches tail-worker-name
                                                   (str (.getFileName p)))]
                  (try
                    (with-open [r (io/reader (.toFile p))]
                      (when-let [header (.readLine r)]
                        (when-let [[_ uuid]
                                   (re-find #"^SHARD WORKER ([0-9a-f-]{36})\b" header)]
                          [uuid (str "worker-" index
                                     (when phase (str "-phase-" phase)))])))
                    (catch java.io.FileNotFoundException _ nil))))
              (tail-regular-files run tail-worker-name))))

(defn- tail-sources [run mode worker-ids]
  (let [workers (when (#{:workers :all} mode)
                  (for [p (tail-regular-files run tail-worker-name)]
                    {:path p :label (str (.getFileName p))}))
        jvms (when (#{:jvm :stderr :all} mode)
               (for [p (tail-regular-files (.resolve run "logs") tail-jvm-name)
                     :let [[_ uuid stream] (re-matches tail-jvm-name
                                                          (str (.getFileName p)))]
                     :when (or (not= mode :stderr) (= stream "stderr"))]
                 {:path p
                  :label (str (get worker-ids uuid (str "jvm-" (subs uuid 0 8)))
                              "/" stream)}))]
    (vec (concat workers jvms))))

(defn- tail-initial-offset [path lines]
  ;; Find the last N lines without loading a potentially multi-GB JVM log.
  (with-open [r (RandomAccessFile. (.toFile path) "r")]
    (let [length (.length r)
          _ (when (pos? length) (.seek r (dec length)))
          terminal-newline? (and (pos? length) (= 10 (.readUnsignedByte r)))
          target (+ lines (if terminal-newline? 1 0))]
      (loop [end length, seen 0]
        (if (zero? end)
          0
          (let [start (max 0 (- end 4096))
                bytes (byte-array (int (- end start)))]
            (.seek r start)
            (.readFully r bytes)
            (if-let [offset
                     (loop [i (dec (alength bytes)), count seen]
                       (when (>= i 0)
                         (if (= 10 (bit-and 0xff (aget bytes i)))
                           (if (= (inc count) target)
                             (+ start i 1)
                             (recur (dec i) (inc count)))
                           (recur (dec i) count))))]
              offset
              (recur start (+ seen (count (filter #(= 10 (bit-and 0xff %)) bytes)))))))))))

(defn- tail-poll-file! [path {:keys [offset partial file-key]} label]
  (try
    (with-open [r (RandomAccessFile. (.toFile path) "r")]
      (let [length (.length r)
            current-key (.fileKey (Files/readAttributes path BasicFileAttributes no-follow))
            restarted? (or (< length offset)
                           (and file-key current-key (not= file-key current-key)))
            ^ByteArrayOutputStream pending (if restarted? (ByteArrayOutputStream.) partial)
            from (if restarted? 0 offset)
            bytes (byte-array 8192)]
        (.seek r from)
        (loop [position from]
          (let [n (.read r bytes)]
            (if (pos? n)
              (do
                (dotimes [i n]
                  (let [b (bit-and 0xff (aget bytes i))]
                    (if (= b 10)
                      (let [line (String. (.toByteArray pending)
                                          StandardCharsets/UTF_8)]
                        (println (str "[" label "] "
                                      (str/replace line #"\r$" "")))
                        (.reset pending))
                      (.write pending b))))
                (recur (+ position n)))
              {:offset position :partial pending :file-key current-key})))))
    (catch java.io.FileNotFoundException _
      ;; A file may disappear between the directory listing and opening it.
      {:offset 0 :partial (ByteArrayOutputStream.)})))

(defn- tail! [root {:keys [run mode once?]}]
  (let [selected (tail-run! root run)
        mode (or mode :jvm)]
    (println "YGG TAIL" (str selected) "mode" (name mode)
             (if once? "snapshot" "following (Ctrl-C to stop)"))
    (flush)
    (loop [known {}, first-scan? true]
      (let [worker-ids (tail-worker-ids selected)
            files (tail-sources selected mode worker-ids)
            next-known
            (reduce (fn [state {:keys [path label]}]
                      (let [old (get known path)
                            start (or old {:offset (if first-scan?
                                                      (tail-initial-offset path 10)
                                                      0)
                                           :partial (ByteArrayOutputStream.)})]
                        (assoc state path (tail-poll-file! path start label))))
                    {} files)]
        (flush)
        (when-not once?
          (Thread/sleep 350)
          (recur next-known false))))))

;; Shard remains the sole source of report validation and rendering. This
;; command selects a safely published run without ZFS privileges/locks, then
;; transparently forwards stdout, stderr and the reporter's exit status.
;; It neither reads nor changes result receipts itself.
(defn- report! [root {:keys [run edn?]}]
  (let [selected (tail-run! root run)
        command (cond-> ["shard" "report" (str selected)]
                  edn? (conj "--edn"))
        process (.start (doto (ProcessBuilder. ^java.util.List command)
                          (.inheritIO)))
        exit (.waitFor process)]
    (when-not (zero? exit)
      (System/exit exit))))

;; Job ranking is an observational view of Shard's validated receipt data.
;; Incomplete and failed reports exit 1 by design, but still contain valid EDN.
;; Never derive success from the exit code alone or read unvalidated receipts.
(defn- explain! [root {:keys [run]}]
  (let [selected (tail-run! root run)
        process (.start (doto (ProcessBuilder. ^java.util.List
                                               ["shard" "explain" (str selected)])
                          (.inheritIO)))
        exit (.waitFor process)]
    (when-not (zero? exit)
      (System/exit exit))))

(defn- jobs-report! [run]
  (let [{:keys [exit out err]} (shell/sh "shard" "report" (str run) "--edn")
        report (try (edn/read-string {:readers {} :default (fn [_ _] ::untrusted)}
                                     out)
                    (catch Exception _ nil))]
    (when-not (and (#{0 1} exit)
                   (map? report)
                   (= :shard/report (:format report))
                   (= 1 (:version report))
                   (#{:pass :fail :incomplete} (:overall report))
                   (= (if (= :pass (:overall report)) 0 1) exit)
                   (vector? (:jobs report))
                   (integer? (:total report))
                   (= (:total report) (count (:jobs report))))
      (fail! "Cannot obtain a validated Shard report"
             {:cause (str/trim (or err ""))}))
    report))

(defn- jobs-estimates! [run report]
  (let [schedule (.resolve run "schedule.edn")]
    (if (Files/exists schedule no-follow)
      (do
        (when-not (Files/isRegularFile schedule no-follow)
          (fail! "Unsafe job schedule file" {:path (str schedule)}))
        (let [value (read-edn (.toFile schedule))
              times (:estimated-ms value)
              ids (set (map :id (:jobs report)))]
          (when-not (and (= :shard/schedule (:format value))
                         (= 1 (:version value))
                         (= (:inventory-sha256 report) (:inventory-sha256 value))
                         (map? times)
                         (= ids (set (keys times)))
                         (every? (fn [[_ n]] (and (integer? n) (<= 0 n))) times))
            (fail! "Run schedule does not match validated job inventory"))
          times))
      {})))

(defn- jobs-duration [ms]
  (cond
    (nil? ms) "-"
    (>= ms 60000) (format "%dm%02ds" (quot ms 60000)
                           (quot (mod ms 60000) 1000))
    (>= ms 1000) (format "%d.%01ds" (quot ms 1000)
                          (quot (mod ms 1000) 100))
    :else (str ms "ms")))

(defn- jobs! [root {:keys [run all? sort]}]
  (let [selected (tail-run! root run)
        report (jobs-report! selected)
        estimates (jobs-estimates! selected report)
        entries (mapv (fn [entry]
                        (let [estimate (get estimates (:id entry))
                              actual (:duration-ms entry)]
                          (assoc entry :estimate estimate
                                 :error (when (and estimate (integer? actual))
                                          (- actual estimate)))))
                      (:jobs report))
        actual (filterv #(and (integer? (:duration-ms %))
                              (string? (:worker-id %))) entries)
        sorted (sort-by (if (= sort :error)
                          (fn [{:keys [id error duration-ms]}]
                            [(if (nil? error) 1 0)
                             (- (Math/abs (long (or error 0))))
                             (- (or duration-ms 0)) id])
                          (fn [{:keys [id duration-ms]}]
                            [(if (nil? duration-ms) 1 0)
                             (- (or duration-ms 0)) id]))
                        (if all? entries actual))
        displayed (if all? sorted (take 20 sorted))]
    (println "YGG JOBS" (name (:overall report))
             "run" (str (.getFileName selected)))
    (println "Measured:" (count actual) "/" (:total report)
             "| order:" (if (= sort :error) "estimate error" "actual duration")
             "| showing:" (count displayed))
    (println "ACTUAL      ESTIMATE    DELTA       WORKER    STATUS         JOB")
    (doseq [{:keys [id duration-ms estimate error worker-id status]} displayed]
      (println (format "%-11s %-11s %-11s %-9s %-14s %s"
                       (jobs-duration duration-ms)
                       (jobs-duration estimate)
                       (if (nil? error) "-"
                           (str (if (neg? error) "-" "+")
                                (jobs-duration (Math/abs (long error)))))
                       (if worker-id
                         (subs worker-id 0 (min 8 (count worker-id))) "-")
                       (name status) id)))
    (when (< (count actual) (:total report))
      (println "INCOMPLETE: jobs without validated receipts have no measured duration"))
    (when (empty? estimates)
      (println "No schedule estimates available for this run"))
    (flush)))

;; Worker timelines are read-only reconstructions from Shard's already
;; validated receipts. The schedule records preferences, never ownership;
;; the actual worker ID and timestamps in each receipt decide chronology.
;; A completed-job interval excludes preflight, cloning and final teardown.
(defn- timeline-elapsed-ms [^Instant earlier ^Instant later]
  (.toMillis (java.time.Duration/between earlier later)))

(defn- timeline-jobs [report]
  (->> (:jobs report)
       (filter #(and (string? (:worker-id %))
                     (string? (:started-at %))
                     (string? (:completed-at %))
                     (integer? (:duration-ms %))))
       (mapv (fn [entry]
               (assoc entry :start (Instant/parse (:started-at entry))
                            :finish (Instant/parse (:completed-at entry)))))))

(defn- timeline-worker-bar [origin end tasks width]
  (let [total (max 1 (timeline-elapsed-ms origin end))]
    (apply str
           (for [i (range width)
                 :let [lo (quot (* i total) width)
                       hi (max (inc lo) (quot (* (inc i) total) width))]]
             (if (some (fn [{job-start :start job-end :finish}]
                         (and (< (timeline-elapsed-ms origin job-start) hi)
                              (> (timeline-elapsed-ms origin job-end) lo))) tasks)
               "#" ".")))))

(defn- timeline! [root {:keys [run]}]
  (let [selected (tail-run! root run)
        report (jobs-report! selected)
        estimates (jobs-estimates! selected report)
        completed (timeline-jobs report)
        ordered (sort-by (juxt :start :finish :id) completed)
        origin (:start (first ordered))
        end (when (seq ordered)
              (reduce (fn [latest {:keys [finish]}]
                        (if (.isAfter ^Instant finish latest) finish latest))
                      (:finish (first ordered)) (rest ordered)))
        workers (->> completed
                     (group-by :worker-id)
                     (map (fn [[worker-id tasks]]
                            (let [jobs (vec (sort-by (juxt :start :finish :id) tasks))]
                              {:worker-id worker-id :jobs jobs
                               :first-start (:start (first jobs))})))
                     (sort-by (juxt :first-start :worker-id))
                     vec)
        missing (- (:total report) (count completed))]
    (println "YGG TIMELINE" (name (:overall report))
             "run" (str (.getFileName selected)))
    (println "Observed completed jobs:" (count completed) "/" (:total report))
    (if-not (seq completed)
      (println "No completed worker intervals available (run may still be starting).")
      (do
        (println "Measured job window:" (jobs-duration (timeline-elapsed-ms origin end))
                 "(first job start to last completion; excludes setup/cleanup)")
        (println "Bars: # executing, . no recorded job; each W# is a display label, not a clone slot")
        (let [width 48]
          (println "Time" (format "+%-9s %s" "0s"
                                  (str "+" (jobs-duration (timeline-elapsed-ms origin end)))))
          (doseq [[idx {:keys [worker-id jobs]}] (map-indexed vector workers)]
            (println (format "W%-2d %s  %s" (inc idx)
                             (timeline-worker-bar origin end jobs width)
                             (subs worker-id 0 (min 8 (count worker-id)))))))
        (println "")
        (doseq [[idx {:keys [worker-id jobs]}] (map-indexed vector workers)]
          (let [busy (reduce + 0 (map :duration-ms jobs))
                first-job (first jobs)
                last-job (last (sort-by :finish jobs))
                latest-end (:finish last-job)
                tail (max 0 (timeline-elapsed-ms latest-end end))
                internal-gaps (reduce + 0
                                      (map (fn [[a b]]
                                             (max 0 (timeline-elapsed-ms (:finish a) (:start b))))
                                           (partition 2 1 jobs)))
                overlaps (count (filter (fn [[a b]] (.isBefore ^Instant (:start b) (:finish a)))
                                        (partition 2 1 jobs)))]
            (println (format "Worker W%d %s | jobs %d | busy %s | between-job gaps %s | idle tail %s"
                             (inc idx) worker-id (count jobs)
                             (jobs-duration busy) (jobs-duration internal-gaps)
                             (jobs-duration tail)))
            (when (pos? overlaps)
              (println "  WARNING: overlapping receipts on this worker:" overlaps))
            (println "  START     GAP       ACTUAL    ESTIMATE   STATUS       JOB")
            (loop [prior nil [task & more] (seq jobs)]
              (when task
                (let [gap (if prior
                            (timeline-elapsed-ms (:finish prior) (:start task))
                            nil)
                      gap-label (cond
                                  (nil? gap) "-"
                                  (neg? gap) (str "OVERLAP " (jobs-duration (- gap)))
                                  :else (jobs-duration gap))]
                  (println (format "  +%-8s %-9s %-9s %-10s %-12s %s"
                                   (jobs-duration (timeline-elapsed-ms origin (:start task)))
                                   gap-label
                                   (jobs-duration (:duration-ms task))
                                   (jobs-duration (get estimates (:id task)))
                                   (name (:status task)) (:id task)))
                  (recur task more))))
            (println)))
        (let [critical (last (sort-by (juxt :finish :id) completed))]
          (println "Last completed job:" (:id critical)
                   "worker" (:worker-id critical)
                   "duration" (jobs-duration (:duration-ms critical))))))
    (when (pos? missing)
      (println "INCOMPLETE OBSERVATION:" missing
               "jobs have no completed worker interval; no times inferred"))
    (flush)
    ;; Keep report's success/failure status, unlike the exploratory jobs list.
    (when-not (= :pass (:overall report)) (System/exit 1))))

(defn- parse-args [argv]
  (loop [xs (seq argv) parsed {}]
    (if (empty? xs)
      parsed
      (let [x (first xs)]
        (cond
          (= "-n" x)
          (do (when (or (not (second xs)) (:n parsed)) (fail! "Invalid or duplicate -n"))
              (let [n (try (Long/parseLong (second xs))
                           (catch Exception _ (fail! "-n must be integer")))]
                (when-not (<= 1 n 256) (fail! "-n must be 1 through 256"))
                (recur (nnext xs) (assoc parsed :n n))))
          (= "--run" x)
          (do (when (or (not (second xs)) (:run parsed)) (fail! "Missing or duplicate --run"))
              (recur (nnext xs) (assoc parsed :run (second xs))))
          (= "--all" x)
          (do (when (:all? parsed) (fail! "Duplicate --all"))
              (recur (next xs) (assoc parsed :all? true)))
          (= "--sort" x)
          (do (when (or (:sort parsed) (nil? (second xs)))
                (fail! "Missing or duplicate --sort"))
              (let [sort-key ({"duration" :duration "error" :error} (second xs))]
                (when-not sort-key (fail! "--sort must be duration or error"))
                (recur (nnext xs) (assoc parsed :sort sort-key))))
          (= "--timeline" x)
          (do (when (:timeline? parsed) (fail! "Duplicate --timeline"))
              (recur (next xs) (assoc parsed :timeline? true)))
          (= "--once" x)
          (do (when (:once? parsed) (fail! "Duplicate --once"))
              (recur (next xs) (assoc parsed :once? true)))
          (#{"--workers" "--stderr" "--all"} x)
          (do (when (:mode parsed) (fail! "Only one tail output mode is allowed"))
              (recur (next xs) (assoc parsed :mode ({"--workers" :workers
                                                     "--stderr" :stderr
                                                     "--all" :all} x))))
          (= "--edn" x)
          (do (when (:edn? parsed) (fail! "Duplicate --edn"))
              (recur (next xs) (assoc parsed :edn? true)))
          (#{"create" "clean" "status" "tail" "report" "explain" "jobs" "timeline"} x)
          (do (when (:action parsed) (fail! "Multiple actions"))
              (recur (next xs) (assoc parsed :action (keyword x))))
          (str/starts-with? x "-") (fail! (str "Unrecognized option: " x))
          (:root parsed) (fail! "Multiple paths supplied")
          :else (recur (next xs) (assoc parsed :root x)))))))
(defn- legacy-lock-absent! [root]
  ;; Earlier Ygg versions serialize commands on a DIFFERENT inode. Using the
  ;; new lock while that inode exists could permit mixed-version mutations.
  ;; Do not unlink it: an older process may still hold a lock on that inode.
  ;; The operator must retire all old Ygg processes before removing the file.
  (when (exists? (legacy-lock-path root))
    (fail! (str "Legacy .ygg.lock exists at " (legacy-lock-path root)
                "; refusing mixed-version Ygg operation. Stop all older Ygg "
                "commands and verify none are running before manually "
                "removing that legacy file."))))
(defn- ensure-command-lock-directory! [root]
  (workspace-shape! root)
  (let [w (workspace root)]
    (when-not (exists? w)
      ;; Concurrent starters may both observe the absent directory. Losing
      ;; this mkdir race is safe; the persistent file lock arbitrates work.
      (when-not (or (.mkdir w) (and (exists? w) (.isDirectory w)))
        (fail! "Unable to create .ygg/ for command lock")))
    (workspace-shape! root)))
(defn- with-lock [root work]
  ;; Preserve the lock inode across invocations. Never delete the lock file.
  ;; A legacy lock is a migration blocker, not evidence that it is unlocked.
  (legacy-lock-absent! root)
  (ensure-command-lock-directory! root)
  (with-file-lock (command-lock-path root)
    "Another Ygg command is running for this repository"
    (fn []
      (legacy-lock-absent! root)
      (work))))
(defn -main [& argv]
  (let [cli (parse-args argv)
        root (canonical (or (:root cli) (System/getProperty "user.dir")))
        config (let [p (f root "ygg.edn")]
                 (if (.isFile p) (read-edn p) {}))
        _ (when-not (map? config) (fail! "ygg.edn must contain a map"))
        _ (when (contains? config :zfs-command)
            (fail! ":zfs-command is no longer configurable for privileged safety"))
        action (or (:action cli) (:action config))
        n (or (:n cli) (:n config) 1)]
    (when-not (.isDirectory (io/file root)) (fail! "Not a directory"))
    (when-not (#{:create :clean :status :tail :report :explain :jobs :timeline} action)
      (fail! "Specify create, clean, status, tail, report, explain, jobs, timeline or :action in ygg.edn"))
    (when-not (and (integer? n) (<= 1 n 256))
      (fail! "Clone count must be 1..256"))
    (when (and (:edn? cli) (:timeline? cli))
      (fail! "--edn and --timeline cannot be combined"))
    (when (and (:timeline? cli) (not= action :report))
      (fail! "--timeline is supported only for report"))
    (when (and (:edn? cli) (not (#{:status :report} action)))
      (fail! "--edn is supported only for status and report"))
    (when (and (not= action :tail) (:mode cli))
      (fail! "Output modes are supported only for tail"))
    (when (and (not= action :tail) (:once? cli))
      (fail! "--once is supported only for tail"))
    (when (and (not= action :jobs) (or (:all? cli) (:sort cli)))
      (fail! "--all and --sort are supported only for jobs"))
    (when (and (not (#{:tail :report :explain :jobs :timeline} action)) (:run cli))
      (fail! "--run is supported only for tail, report, explain, jobs and timeline"))
    (when (and (#{:tail :report :explain :jobs :timeline} action) (:n cli))
      (fail! "-n is not supported for tail, report, explain, jobs or timeline"))
    (case action
      :tail (tail! root cli)
      :report (if (:timeline? cli) (timeline! root cli) (report! root cli))
      :timeline (timeline! root cli)
      :explain (explain! root cli)
      :jobs (jobs! root cli)
      (let [source (source-dataset root)]
        (with-lock root #(case action
                           :create (with-worker-idle root (fn [] (create! root source n)))
                           :clean (with-worker-idle root (fn [] (clean! root source)))
                           :status (status! root source (:edn? cli))))))))
(try
  (apply -main *command-line-args*)
  (catch Exception e
    (binding [*out* *err*]
      (println "ygg:" (.getMessage e))
      (when-let [d (ex-data e)]
        (when (:cause d) (println (:cause d)))))
    (System/exit 1)))
